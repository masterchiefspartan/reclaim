rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if a field has changed between two resources
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }
    
    // Generic type checkers
    function isString(val) { return val is string; }
    function isNumber(val) { return val is number; }
    function isBoolean(val) { return val is bool; }
    function isTimestamp(val) { return val is timestamp; }
    
    // Optional field check: if present, must match type
    function optionalString(data, field) {
      return !data.keys().hasAny([field]) || isString(data[field]);
    }
    function optionalNumber(data, field) {
      return !data.keys().hasAny([field]) || isNumber(data[field]);
    }
    
    // Valid Mood Levels
    function isValidMood(mood) {
      return mood in ['sad', 'neutral', 'hopeful', 'grateful', 'energized', 'anxious'];
    }

    // --- Collection Rules ---
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    match /journalEntries/{entryId} {
      
      function isValidEntryCreate() {
        let data = request.resource.data;
        
        // Required fields for creation
        return data.keys().hasAll(['userId', 'createdAt', 'updatedAt', 'duration', 'checkInType']) &&
          data.userId == request.auth.uid &&
          isTimestamp(data.createdAt) &&
          isTimestamp(data.updatedAt) &&
          isNumber(data.duration) &&
          (data.checkInType == 'free' || data.checkInType == 'guided') &&
          
          // Initial Status
          (data.transcriptionStatus == 'pending') &&
          (data.aiResponseStatus == 'pending') &&

          // Optional fields validation
          optionalString(data, 'audioUrl') &&
          optionalString(data, 'transcript') &&
          optionalString(data, 'aiResponse');
      }

      function isValidEntryUpdate() {
        let data = request.resource.data;
        
        // Immutable fields
        return isUnchanged('userId') && 
          isUnchanged('createdAt') &&
          
          // Must update 'updatedAt'
          isTimestamp(data.updatedAt) &&
          data.updatedAt != resource.data.updatedAt &&
          
          // Mood Validation (if being updated)
          (!data.keys().hasAny(['mood']) || isValidMood(data.mood)) &&
          
          // Numeric validation
          optionalNumber(data, 'moodScore') &&
          optionalNumber(data, 'painLevel');
      }

      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && isValidEntryCreate();
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        isValidEntryUpdate();
      
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
