    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "security:check": "npm audit && npm run lint:security",
    "security:fix": "npm audit fix",
    "prepare": "husky"
