    "@react-navigation/native-stack": "^7.6.2",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "expo": "~54.0.32",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.12",
    "expo-file-system": "~19.0.21",
