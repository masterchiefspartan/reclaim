# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY="your-api-key-here"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
EXPO_PUBLIC_FIREBASE_APP_ID="your-app-id"
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Firebase App Check (Optional but recommended for production)
# Prevents unauthorized apps from accessing your Firebase resources
# Get from: Firebase Console > App Check > Get started
# See: https://firebase.google.com/docs/app-check
EXPO_PUBLIC_APP_CHECK_SITE_KEY="your-recaptcha-enterprise-site-key"

# DEV ONLY: Bypass paywall/onboarding for testing
# Set to "true" to skip paywall, onboarding, and permissions screens
# WARNING: NEVER enable this in production!
EXPO_PUBLIC_DEV_BYPASS_PAYWALL="false"

# Note: EXPO_PUBLIC_ prefix makes these accessible in the app
# For server-side only secrets (API keys), use Firebase Functions environment:
# See functions/.env.example for required backend secrets
#
# SECURITY NOTES:
# - NEVER commit .env files with real values
# - AI service keys (Deepgram, Claude, ElevenLabs) are server-side ONLY
# - Client gets temporary tokens via getStreamingTokens() callable function
# - Enable App Check in production to prevent API abuse
