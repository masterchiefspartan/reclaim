# Firebase Functions Environment Variables
# Copy this file to .env and fill in your actual API keys
#
# SECURITY NOTES:
# - NEVER commit .env files with real values to version control
# - These keys are server-side ONLY and never exposed to clients
# - Rotate keys every 90 days for production
# - Monitor API usage for anomalies

# Deepgram API Key (for speech-to-text)
# Get from: https://console.deepgram.com
# Recommended: Use scoped API key with only 'usage:write' permission
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API Key (for text-to-speech)
# Get from: https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Claude/Anthropic API Key (for AI responses)
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key_here

# App Check Enforcement (optional)
# Set to "true" to require App Check tokens for all callable functions
# WARNING: Enable only after App Check is properly configured in the client
APP_CHECK_REQUIRED=false
